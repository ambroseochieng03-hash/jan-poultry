# JAN Poultry environment. Copy to .env (never commit .env).
# One KEY=value per line, no quotes, no trailing comments.

# development or production
APP_ENV=production
APP_URL=https://janpoultry.luxempire.co.ke
SUPER_ADMIN_EMAIL=

DB_HOST=127.0.0.1
DB_NAME=janpoultry
DB_USER=janpoultry
DB_PASSWORD=

GOOGLE_MAPS_API_KEY=

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=JAN Poultry

# Used from the media/queue phase onwards
# local = legacy (files in public/uploads), r2 = queue + Cloudflare R2
MEDIA_DRIVER=local
MEDIA_INCOMING_DIR=/var/lib/janpoultry/incoming
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=3
NATS_URL=nats://127.0.0.1:4222
R2_ENDPOINT=
R2_BUCKET=janpoultry-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
MEDIA_BASE_URL=https://jpmedia.luxempire.co.ke
