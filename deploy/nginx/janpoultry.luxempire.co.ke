# /etc/nginx/sites-available/janpoultry.luxempire.co.ke  (symlink into sites-enabled)
server {
    listen 80;
    listen [::]:80;
    listen 443 ssl;
    listen [::]:443 ssl;

    server_name janpoultry.luxempire.co.ke;

    ssl_certificate     /etc/nginx/ssl/luxempire/origin.crt;
    ssl_certificate_key /etc/nginx/ssl/luxempire/origin.key;

    # ONLY /public is web-reachable. app/, includes/, storage/, vendor/, .env
    # sit one level above and cannot be requested at all.
    root /srv/http/janpoultry/public;
    index index.php;

    access_log /var/log/nginx/janpoultry-access.log;
    error_log  /var/log/nginx/janpoultry-error.log;

    server_tokens off;
    client_max_body_size 110M;

    add_header Strict-Transport-Security "max-age=15552000" always;

    error_page 404 /errors/404.html;
    error_page 500 502 503 504 /errors/500.html;
    location ^~ /errors/ { internal; }

    # dotfiles / sensitive extensions never served (belt and braces)
    location ~ /\.                                  { return 404; }
    location ~* \.(env|log|sql|md|bak|old|orig|save|swp|ini|ya?ml|lock)$ { return 404; }

    # receipts contain customer data: never served statically
    location ^~ /uploads/receipts/ { return 404; }

    # static files
    location ^~ /assets/ {
        add_header X-Content-Type-Options nosniff always;
        add_header Cache-Control "public, max-age=2592000" always;
        try_files $uri =404;
    }
    location ^~ /uploads/ {
        add_header X-Content-Type-Options nosniff always;
        add_header Cache-Control "public, max-age=2592000" always;
        try_files $uri =404;
    }
    location = /robots.txt { try_files $uri =404; }

    # brute-force flood limit on credential endpoints (app lockout still applies)
    location ~ ^/(login|register|guest-login|reset-password|forgot-password-ajax|admin/login|admin/reset-password|admin/forgot-password-ajax)$ {
        limit_req zone=jp_auth burst=15 nodelay;
        limit_req_status 429;
        include snippets/janpoultry-php.conf;
    }

    # every other clean URL -> front controller
    location / {
        limit_req zone=jp_general burst=100 nodelay;
        try_files $uri /index.php$is_args$args;
    }

    location = /index.php {
        internal;
        include snippets/janpoultry-php.conf;
    }

    # any .php a browser asks for directly never executes
    location ~ \.php$ { return 404; }
}
